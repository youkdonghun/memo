{
  "name": "memo-bom",
  "version": "1.1.1",
  "description": "업무의 효율화와 기본 스티커메모의 한계를 극복하기 위한 데스크톱 메모 앱입니다.",
  "main": "src/main.cjs",
  "homepage": "https://blog.naver.com/sap_y",
  "author": "sap-scriptorium",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run dist:win",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never",
    "dist:all": "electron-builder --win nsis --mac dmg --universal --publish never"
  },
  "build": {
    "appId": "com.youk.memobom",
    "productName": "MEMO BOM",
    "copyright": "Copyright 2026 sap-scriptorium",
    "files": [
      "src/**/*",
      "build/**/*",
      "!build/icon.icns",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "legalTrademarks": "sap-scriptorium"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "artifactName": "MEMO BOM Setup ${version}-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "build/icon.png"
        },
        {
          "from": "build/icon.icns",
          "to": "build/icon.icns"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MEMO BOM",
      "artifactName": "MEMO BOM Setup ${version}.${ext}",
      "license": "build/license.html",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerLanguages": [
        "ko"
      ],
      "uninstallDisplayName": "MEMO BOM",
      "uninstallUrlHelp": "https://blog.naver.com/sap_y",
      "uninstallUrlInfoAbout": "https://blog.naver.com/sap_y",
      "uninstallUrlReadme": "https://blog.naver.com/sap_y"
    }
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  }
}
